# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Raw and processed data — too large for git
datasets/

# Intermediate pipeline outputs — regenerable
# (already covered by the blanket "datasets/" rule above; listed
# explicitly per dataset for clarity)
datasets/stepup/d02_prep/
datasets/stepup/d03_clean/
datasets/stepup/d04_gaitepochs/
datasets/stepup/d05_ersp/
datasets/stepup/d00_qc/
datasets/jacobsen/d02_prep/
datasets/jacobsen/d03_clean/
datasets/jacobsen/d04_gaitepochs/
datasets/jacobsen/d05_ersp/
datasets/jacobsen/d00_qc/

# Large binary file types 
*.fif
*.npy
*.pkl
*.eeg
*.set
*.fdt
*.mat

# Multiverse intermediates — regenerable (nested per dataset, see
# src.config.DIR_MULTIVERSE_COMET / DIR_MULTIVERSE_BRANCHES)
results/multiverse/*/comet/
results/multiverse/*/branches/

# COMET per-universe scripts — regenerable via --create
# (universe_N.py files inside comet/ are already covered above)

# Keep final outputs even if they match binary patterns above
!results/multiverse/*/outputs/multiverse_results.pkl
!results/multiverse/*/outputs/*.tsv
!results/multiverse/*/outputs/*.png
!results/multiverse/*/outputs/*.pdf
!results/pipeline/*/plots/*.png
!results/pipeline/*/qc/*.tsv

# Legacy
old scripts/
initialanalysis.ipynb
uv.lock
possibleDatasets.xlsx

# GEDAI -- evaluated, excluded from the multiverse (see README). Kept on
# disk as a methods-validation record, untracked only; do NOT add
# src/nodes/gedai_node.py here -- that one is tracked, in-repo pipeline
# code cited directly by the README.
scripts/diag_gedai_check.py
results/pipeline/*/qc/gedai_gate_check.txt

# Diagnostic / one-off investigation scripts and their reports
scripts/diag_band_diagnostics.py
scripts/diag_jacobsen_dataquality.py
scripts/diag_jacobsen_baseline_check.py
results/pipeline/*/qc/band_diagnostics.txt
results/pipeline/jacobsen/qc/dataquality_audit.txt
results/pipeline/jacobsen/qc/baseline_120s_check.txt

# Ad-hoc run logs and throwaway launcher batch files
*.log
logs/
run_jacobsen2.bat

# Claude Code local tooling config
.claude/
